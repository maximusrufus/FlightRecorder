# Production key material (required unless FLIGHTRECORDER_DEV=1).
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FLIGHTRECORDER_KEK=
FLIGHTRECORDER_SIGNING_KEY=

# Local development ONLY — ephemeral random keys, every record stamped
# dev_mode=true. Do not set this in production.
# FLIGHTRECORDER_DEV=1

FLIGHTRECORDER_DATA_DIR=./data
FLIGHTRECORDER_WITNESS_DIR=./data/witness
FLIGHTRECORDER_MAX_PAYLOAD_BYTES=1048576

# Stripe billing (optional — safe by default if unset).
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_CORE=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# STRIPE_WEBHOOK_SECRET=

# Fallback if Stripe isn't configured: redirect checkout to this URL.
# PAYMENT_LINK_URL=
